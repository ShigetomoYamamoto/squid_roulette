{
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-code-plugins": {
      "source": {
        "repo": "anthropics/claude-code",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "python3 /Users/shigetomo-yamamoto/personal-development/squid_roulette/.claude/hooks/protected-branch-edit-guard.py",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      },
      {
        "hooks": [
          {
            "command": "python3 /Users/shigetomo-yamamoto/personal-development/squid_roulette/.claude/hooks/git-destructive-blocker.py",
            "type": "command"
          },
          {
            "command": "python3 /Users/shigetomo-yamamoto/personal-development/squid_roulette/.claude/hooks/pr-base-checker.py",
            "type": "command"
          },
          {
            "command": "python3 /Users/shigetomo-yamamoto/personal-development/squid_roulette/.claude/hooks/commit-msg-convention.py",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(claude *)",
      "Bash(curl *)"
    ]
  }
}
